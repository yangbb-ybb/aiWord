# 复制为 .env 后填实际值
# -------------------------
# 服务
# -------------------------
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# 是否把 AI 完整回复原文写到日志文件（最长 ~16k 字符/条）
# 默认 true。线上想关就改 false，省日志体积
LOG_AI_OUTPUT=true

# 跨域允许（前端 dev 地址）
CORS_ORIGIN=http://localhost:5173

# 写接口需要的 API key（前端 fetch 时通过 header x-api-key 带过来；留空表示不校验）
AUTH_TOKEN=

# -------------------------
# MySQL（本地实例）
# -------------------------
# 形如 mysql://user:password@host:port/database
MYSQL_URL=mysql://root:root@localhost:3306/aiword

# -------------------------
# AI Provider（minimax 走 Anthropic 兼容协议）
# -------------------------
# 切到 minimax 只需改这两个：
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=claude-sonnet-4-5

# 也可临时切到 Anthropic 官方：
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
